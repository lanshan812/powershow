{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PowerShow",
  "version": "2.0.0",
  "identifier": "top.lanshan.powershow",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PowerShow",
        "width": 300,
        "height": 190,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}