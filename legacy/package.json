{
  "name": "battery-card",
  "version": "1.0.0",
  "description": "PowerShow - macOS-style floating battery card for Bluetooth peripherals",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder -mwl --dir=false",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "license": "MIT",
  "type": "commonjs",
  "author": "lanshan812",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "top.lanshan.powershow",
    "productName": "PowerShow",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "collectors/**",
      "!docs/**"
    ],
    "win": {
      "target": [
        { "target": "zip", "arch": ["x64"] }
      ]
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "tar.gz", "arch": ["x64"] }
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  }
}
