# Ubuntu 24.04+ AppArmor 用户命名空间限制修复
# 用法：
#   sudo cp powershow /etc/apparmor.d/
#   sudo apparmor_parser -r /etc/apparmor.d/powershow
# 说明：Ubuntu 24.04+ 默认 kernel.apparmor_restrict_unprivileged_userns=1，
# WebKitGTK 的 bwrap 沙箱无法创建，导致 Tauri 应用窗口空白/透明不可见。
# 此配置为 powershow 授予 userns 权限（与 Ubuntu 官方给 Chrome 的做法一致）。

abi <abi/4.0>,
include <tunables/global>

profile powershow /usr/bin/powershow flags=(unconfined) {
  userns,

  include if exists <local/powershow>
}

# 开发路径
profile powershow-dev /home/*/battery-card/src-tauri/target/release/powershow flags=(unconfined) {
  userns,
}
profile powershow-dev2 /home/*/powershow-tauri/src-tauri/target/release/powershow flags=(unconfined) {
  userns,
}